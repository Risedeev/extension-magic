{
  "manifest_version": 3,
  "name": "Rise Lovable",
  "version": "1.0.0",
  "description": "Rise Lovable — assistente para Lovable.dev",
  "permissions": [
    "activeTab",
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "https://storage.googleapis.com/*",
    "https://*.storage.googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://riselovable.lovable.app/*",
    "https://*.lovable.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["content-standard-chat.js", "content-panel.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "license.js",
        "fix-error-transport.js",
        "history.js",
        "ui-extras.js",
        "page-fetch-patch.js",
        "icons/*",
        "vendor/*"
      ],
      "matches": ["https://*.lovable.dev/*", "https://lovable.dev/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
